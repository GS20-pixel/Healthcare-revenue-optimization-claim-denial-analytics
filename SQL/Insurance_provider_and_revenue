/*==========================================
 Insurance Provider & Revenue Impact
==========================================*/

-- 1.Total Claims by Insurance Provider

SELECT
    insurance_provider,
    COUNT(*) AS total_claims
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY total_claims DESC;


--2. Revenue by Insurance Provider

SELECT
    insurance_provider,
    ROUND(SUM(billed_amount),2) AS billed_revenue,
    ROUND(SUM(paid_amount),2) AS collected_revenue
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY billed_revenue DESC;


--3.  Revenue Collection Rate

SELECT
    insurance_provider,
    ROUND(
        (SUM(paid_amount) * 100.0) /
        SUM(billed_amount),
        2
    ) AS collection_rate
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY collection_rate DESC;


-- 4.Revenue Leakage by Insurance Provider

SELECT
    insurance_provider,
    ROUND(SUM(billed_amount - paid_amount),2) AS revenue_leakage
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY revenue_leakage DESC;


--5. Average Claim Amount

SELECT
    insurance_provider,
    ROUND(AVG(billed_amount),2) AS average_claim_amount
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY average_claim_amount DESC;


--6. Claim Status by Insurance Provider

SELECT
    insurance_provider,
    claim_status,
    COUNT(*) AS total_claims
FROM claims_and_billing
GROUP BY insurance_provider, claim_status
ORDER BY insurance_provider;


-- 7.Total Paid Amount by Insurance Provider

SELECT
    insurance_provider,
    ROUND(SUM(paid_amount),2) AS total_paid_amount
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY total_paid_amount DESC;


-- 8.Highest Paying Insurance Providers

SELECT
    insurance_provider,
    ROUND(AVG(paid_amount),2) AS average_paid_amount
FROM claims_and_billing
GROUP BY insurance_provider
ORDER BY average_paid_amount DESC
LIMIT 10;

